<?xml version="1.0"?>
<!--
/**
 * Default Configuration Values (v2)
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <artlounge_bento>
            <general>
                <enabled>0</enabled>
                <site_uuid></site_uuid>
                <publishable_key></publishable_key>
                <secret_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <source>artlounge</source>
                <debug>0</debug>
                <test_mode_emails></test_mode_emails>
            </general>
            <orders>
                <include_tax>1</include_tax>
            </orders>
            <abandoned_cart>
                <enabled>1</enabled>
                <delay_minutes>60</delay_minutes>
                <min_value>500</min_value>
                <contact_capture_delay_minutes>30</contact_capture_delay_minutes>
                <coupon_enabled>0</coupon_enabled>
                <coupon_min_subtotal>2000</coupon_min_subtotal>
                <coupon_prefix>BENTO</coupon_prefix>
                <coupon_lifetime_days>7</coupon_lifetime_days>
                <coupon_discount_type>by_percent</coupon_discount_type>
                <coupon_discount_amount>10</coupon_discount_amount>
            </abandoned_cart>
            <tracking>
                <enabled>1</enabled>
                <track_views>1</track_views>
                <track_cart>1</track_cart>
                <contact_capture>1</contact_capture>
                <include_brand>1</include_brand>
                <brand_attribute>manufacturer</brand_attribute>
            </tracking>
            <profile>
                <!-- category_id=medium. Deepest mapped ancestor of a product's category wins.
                     Derived from the live category tree 2026-10-13. Unmapped categories are ignored. -->
