<?xml version="1.0"?>
<!--
/**
 * Admin System Configuration (v2)
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="artlounge" translate="label" sortOrder="400">
            <label>ArtLounge</label>
        </tab>
        <section id="artlounge_bento" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Bento Integration</label>
            <tab>artlounge</tab>
            <resource>ArtLounge_BentoCore::config</resource>

            <group id="general" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Integration</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Master switch. When off, nothing is queued, sent or loaded in the browser.</comment>
                </field>
                <field id="site_uuid" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Site UUID</label>
                </field>
                <field id="publishable_key" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Publishable Key</label>
                </field>
                <field id="secret_key" translate="label comment" type="obscure" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Secret Key</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Encrypted in the database. Also signs cart recovery links.</comment>
                </field>
                <field id="source" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Source Identifier</label>
                </field>
                <field id="test_mode_emails" translate="label comment" type="textarea" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Test Mode: Email Allow-list</label>
                    <comment><![CDATA[One glob per line or comma separated, e.g. <code>*+bentotest*@*</code>. When set, ONLY matching emails are sent to Bento (others are marked skipped) and backfill is restricted to them. Leave EMPTY on production.]]></comment>
                </field>
                <field id="debug" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Debug Logging (var/log/bento.log)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="test_connection" translate="label" type="button" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Test Connection</label>
                    <frontend_model>ArtLounge\BentoCore\Block\Adminhtml\System\Config\TestConnection</frontend_model>
                </field>
            </group>

            <group id="tracking" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Browser Tracking</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Browser Tracking (Bento SDK)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="track_views" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product Views ($view)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="track_cart" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cart Changes ($cart_updated)</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="contact_capture" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Magic Checkout Contact Capture</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Stores email/phone typed into the Razorpay popup so a tab-close still produces $checkout_abandoned.</comment>
                </field>
                <field id="include_brand" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Include Brand</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="brand_attribute" translate="label" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Brand Attribute Code</label>
                </field>
            </group>

            <group id="reviews" translate="label" sortOrder="25" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product Reviews</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Send $review_submitted</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment><![CDATA[Fires when a shopper submits a product review on the storefront. Logged-in reviewers are identified by their account email; guests only via the <code>bento_uuid</code> Bento adds to email links (remembered in a first-party cookie by the browser layer, so Browser Tracking must be on). Guests with no identity are not sent.]]></comment>
                </field>
            </group>

            <group id="abandoned_cart" translate="label" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Abandonment &amp; Coupons</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable $cart_abandoned</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="delay_minutes" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Cart Idle Delay (minutes)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="min_value" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Minimum Cart Value (₹)</label>
                    <validate>validate-number</validate>
                </field>
                <field id="contact_capture_delay_minutes" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Contact-Capture Timeout (minutes)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="coupon_enabled" translate="label comment" type="select" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Recovery Coupons</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Coupons are only ever attached to $cart_abandoned (never checkout events), and Bento shows them only in the last recovery email.</comment>
                </field>
                <field id="coupon_min_subtotal" translate="label comment" type="text" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Coupon Threshold (₹ cart subtotal)</label>
                    <validate>validate-number</validate>
                    <comment>Carts below this get coupon_eligible=false and no code. Also enforced as the managed rule's subtotal condition.</comment>
                </field>
                <field id="coupon_discount_type" translate="label" type="select" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Discount Type</label>
                    <source_model>ArtLounge\BentoCore\Model\Config\Source\DiscountType</source_model>
                </field>
                <field id="coupon_discount_amount" translate="label" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Discount Amount</label>
                    <validate>validate-number</validate>
                </field>
                <field id="coupon_lifetime_days" translate="label" type="text" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Coupon Lifetime (days)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
                <field id="coupon_prefix" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Coupon Prefix</label>
                </field>
                <field id="managed_rule_info" translate="label" type="label" sortOrder="110" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Managed Cart Price Rule</label>
                    <frontend_model>ArtLounge\BentoCore\Block\Adminhtml\System\Config\ManagedRuleInfo</frontend_model>
                </field>
            </group>

            <group id="profile" translate="label" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Customer Profile Fields</label>
                <field id="category_medium_map" translate="label comment" type="textarea" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Category → Medium Map</label>
                    <comment><![CDATA[One <code>category_id=medium</code> per line (# for comments). The deepest mapped category of each purchased product decides its medium; primary_medium = highest spend share. Unmapped categories are ignored.]]></comment>
                </field>
            </group>

            <group id="advanced" translate="label" sortOrder="90" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Advanced</label>
                <field id="timeout" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>HTTP Timeout (seconds)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                </field>
            </group>
        </section>
    </system>
</config>
