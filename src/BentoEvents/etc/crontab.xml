<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Drain the outbox (DB lock, ≤100 rows, ≤30s). Idle run = one indexed SELECT. -->
        <job name="artlounge_bento_outbox_send" instance="ArtLounge\BentoEvents\Cron\SendOutbox" method="execute">
            <schedule>* * * * *</schedule>
        </job>
        <!-- Contact-capture timeouts + idle identified carts -->
        <job name="artlounge_bento_abandonment" instance="ArtLounge\BentoEvents\Cron\Abandonment" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <!-- Missing purchases, contact-capture health, cleanup (03:15 server time) -->
        <job name="artlounge_bento_reconcile" instance="ArtLounge\BentoEvents\Cron\Reconcile" method="execute">
            <schedule>15 3 * * *</schedule>
        </job>
        <!-- next_pick_* / new_in_* / usual_* for buyers in the admin Refresh Window (130 days) + all VIPs, so the lists follow stock (03:45 server time) -->
        <job name="artlounge_bento_next_picks" instance="ArtLounge\BentoEvents\Cron\RefreshNextPicks" method="execute">
            <schedule>45 3 * * *</schedule>
        </job>
        <!-- Expired / old used recovery coupons -->
        <job name="artlounge_bento_coupon_cleanup" instance="ArtLounge\BentoEvents\Cron\CouponCleanup" method="execute">
            <schedule>0 4 * * *</schedule>
        </job>
        <!-- Carts abandoned in the last 4 days: fresh ladder / discount / coupon fields, so a sale or ladder change
             reaches the cart emails still to come. Hourly: a sale starting at midnight is picked up within the hour. -->
        <job name="artlounge_bento_open_carts" instance="ArtLounge\BentoEvents\Cron\RefreshOpenCarts" method="execute">
            <schedule>20 * * * *</schedule>
        </job>
    </group>
</config>
