<?xml version="1.0"?>
<!--
/**
 * Database Schema (v2)
 *
 * v1 tables artlounge_bento_abandoned_cart_schedule, artlounge_bento_event_outbox and
 * artlounge_bento_event_sent are intentionally absent: they stay in db_schema_whitelist.json
 * so setup:upgrade drops them.
 */
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <!-- Outbox: one row per thing that happened; payload built at send time -->
    <table name="artlounge_bento_outbox" resource="default" engine="innodb" comment="Bento Event Outbox">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar" name="event_type" nullable="false" length="40" comment="Outbox event type (purchase, cart_abandoned, ...)"/>
        <column xsi:type="varchar" name="entity_type" nullable="false" length="20" comment="order, quote, creditmemo, subscriber, customer, contact"/>
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" default="0" comment="Entity ID"/>
        <column xsi:type="varchar" name="email" nullable="false" length="255" comment="Lower-cased recipient email"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store ID"/>
        <column xsi:type="varchar" name="dedup_key" nullable="false" length="190" comment="Unique per logical event"/>
        <column xsi:type="text" name="context" nullable="true" comment="Small JSON context (source, rzp order id, ...)"/>
        <column xsi:type="varchar" name="status" nullable="false" length="12" default="pending" comment="pending|sending|sent|parked|skipped"/>
        <column xsi:type="smallint" name="attempts" unsigned="true" nullable="false" default="0" comment="Failed attempts"/>
        <column xsi:type="datetime" name="next_attempt_at" nullable="true" comment="Due time (UTC)"/>
        <column xsi:type="text" name="last_error" nullable="true" comment="Last error / skip reason / 4xx body"/>
        <column xsi:type="datetime" name="created_at" nullable="false" comment="When it happened (UTC) — becomes details.timestamp"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
        <column xsi:type="datetime" name="sent_at" nullable="true" comment="Sent At (UTC)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ARTLOUNGE_BENTO_OUTBOX_DEDUP_KEY">
            <column name="dedup_key"/>
        </constraint>
        <index referenceId="ARTLOUNGE_BENTO_OUTBOX_STATUS_NEXT_ATTEMPT_AT" indexType="btree">
            <column name="status"/>
            <column name="next_attempt_at"/>
        </index>
        <index referenceId="ARTLOUNGE_BENTO_OUTBOX_EMAIL" indexType="btree">
            <column name="email"/>
        </index>
        <index referenceId="ARTLOUNGE_BENTO_OUTBOX_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>

    <!-- Purchase markers: an order is a "purchase" once, forever (survives outbox cleanup).
         Gates $purchase (insert-once) and $OrderCanceled (only if marker exists);
         purchased_at is last_purchase_date. Seeded from historic orders on install. -->
    <table name="artlounge_bento_purchase" resource="default" engine="innodb" comment="Bento Purchase Markers">
        <column xsi:type="int" name="order_id" unsigned="true" nullable="false" comment="sales_order.entity_id"/>
        <column xsi:type="varchar" name="increment_id" nullable="false" length="50" comment="Increment ID"/>
        <column xsi:type="varchar" name="email" nullable="false" length="255" comment="Lower-cased email"/>
        <column xsi:type="datetime" name="purchased_at" nullable="false" comment="First seen paid (UTC)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="order_id"/>
        </constraint>
        <index referenceId="ARTLOUNGE_BENTO_PURCHASE_EMAIL" indexType="btree">
            <column name="email"/>
        </index>
    </table>

    <!-- Contact captured from the Razorpay Magic Checkout popup (browser) -->
    <table name="artlounge_bento_checkout_contact" resource="default" engine="innodb" comment="Bento Magic Checkout Contact Capture">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false" comment="Quote ID"/>
        <column xsi:type="varchar" name="rzp_order_id" nullable="false" length="64" comment="Razorpay order id (one per checkout attempt)"/>
        <column xsi:type="varchar" name="email" nullable="false" length="255" comment="Email"/>
        <column xsi:type="varchar" name="phone" nullable="true" length="32" comment="Phone"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store ID"/>
        <column xsi:type="varchar" name="status" nullable="false" length="12" default="pending" comment="pending|enqueued|cancelled"/>
        <column xsi:type="datetime" name="due_at" nullable="false" comment="Check after (UTC)"/>
        <column xsi:type="datetime" name="created_at" nullable="false" comment="Created (UTC)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="ARTLOUNGE_BENTO_CHECKOUT_CONTACT_RZP_ORDER_ID">
            <column name="rzp_order_id"/>
        </constraint>
        <index referenceId="ARTLOUNGE_BENTO_CHECKOUT_CONTACT_STATUS_DUE_AT" indexType="btree">
            <column name="status"/>
            <column name="due_at"/>
        </index>
        <index referenceId="ARTLOUNGE_BENTO_CHECKOUT_CONTACT_QUOTE_ID" indexType="btree">
            <column name="quote_id"/>
        </index>
    </table>

    <!-- Links auto-generated recovery coupons to quote ids -->
    <table name="salesrule_coupon" resource="default">
        <column xsi:type="varchar" name="description" nullable="true" length="255"
                comment="Description — used by Bento to link auto-generated coupons to quote IDs"/>
    </table>
</schema>
