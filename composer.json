{
    "name": "artlounge/magento2-bento",
    "description": "Magento 2 to Bento email marketing: transactional outbox + cron, Razorpay Magic Checkout abandonment, customer profile fields",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "magento2",
        "bento",
        "email",
        "marketing",
        "outbox",
        "razorpay"
    ],
    "homepage": "https://github.com/stuli1989/magento2-bento",
    "require": {
        "php": ">=8.1",
        "magento/framework": "*",
        "magento/module-store": "*",
        "magento/module-config": "*",
        "magento/module-backend": "*",
        "magento/module-sales": "*",
        "magento/module-customer": "*",
        "magento/module-newsletter": "*",
        "magento/module-quote": "*",
        "magento/module-catalog": "*",
        "magento/module-checkout": "*",
        "magento/module-sales-rule": "*",
        "magento/module-review": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "mockery/mockery": "^1.6",
        "symfony/console": "^5.4 || ^6.0 || ^7.0"
    },
    "autoload": {
        "files": [
            "src/BentoCore/registration.php",
            "src/BentoEvents/registration.php",
            "src/BentoTracking/registration.php"
        ],
        "psr-4": {
            "ArtLounge\\BentoCore\\": "src/BentoCore/",
            "ArtLounge\\BentoEvents\\": "src/BentoEvents/",
            "ArtLounge\\BentoTracking\\": "src/BentoTracking/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Magento\\": "tests/Stubs/Magento/",
            "Psr\\Log\\": "tests/Stubs/Psr/Log/",
            "Razorpay\\": "tests/Stubs/Razorpay/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "php tests/tools/vendor/bin/phpunit -c phpunit.xml && node tests/js/cart-diff.test.js"
    }
}
